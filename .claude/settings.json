{
  "permissions": {
    "allow": [
      "Bash(openspec list)",
      "Bash(openspec list *)",
      "Bash(openspec status *)",
      "Bash(openspec validate *)",
      "Bash(openspec instructions *)",
      "Bash(openspec show *)",
      "Bash(./gradlew test)",
      "Bash(./gradlew test *)",
      "Bash(./gradlew lint)",
      "Bash(./gradlew lint *)",
      "Bash(./gradlew assembleDebug)",
      "Bash(./gradlew assembleDebug *)",
      "Bash(./gradlew check)",
      "Bash(./gradlew check *)",
      "Bash(./gradlew :cube:test)",
      "Bash(./gradlew :cube:test *)",
      "Bash(./gradlew :app:testDebugUnitTest)",
      "Bash(./gradlew :app:testDebugUnitTest *)",
      "Bash(./gradlew :app:assembleDebug)",
      "Bash(./gradlew :app:lintDebug)",
      "Bash(./gradlew test lint assembleDebug)",
      "Bash(./gradlew test lint assembleDebug *)",
      "Bash(tools/setup-android-sdk.sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
